# Copy to .env — never commit the filled-in version.
# Runtime secrets live in Workers Secrets, not here; this file is for the
# tooling that runs on your machine (drizzle-kit) plus local development.

# --- drizzle-kit against the remote D1 (pnpm run db:push / db:migrate) -------
CLOUDFLARE_ACCOUNT_ID=""
# from: pnpm exec wrangler d1 create almostdonedear --location weur
CLOUDFLARE_DATABASE_ID=""
# API token with D1 edit permission
CLOUDFLARE_D1_TOKEN=""

# --- local development (wrangler reads .dev.vars for the Worker itself) ------
# RESEND_API_KEY=""
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# SESSION_SECRET=""
