{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "almostdonedear",
	"compatibility_date": "2026-08-13",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true },

	// One environment on purpose. Cloudflare Workers Builds deploys with a bare
	// `npx wrangler deploy` (ADR-024), so anything hidden behind `--env` would be
	// silently skipped. Local development overrides vars through .dev.vars, which
	// is gitignored — see .dev.vars.example.

	// Created with: wrangler d1 create almostdonedear --location weur
	// The EU location hint is a deliberate placement decision — see ADR-016.
	// No "remote": true here on purpose: `wrangler dev` works against a local
	// D1, so development never writes into the production database.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "almostdonedear",
			"database_id": "fc593bd1-ceab-40dd-aefb-ce2b08c4d746",
			"migrations_dir": "drizzle"
		}
	],

	"vars": {
		"PUBLIC_ORIGIN": "https://almostdonedear.app"
	}

	// Secrets (never in this file — `pnpm exec wrangler secret put <NAME>`):
	//   RESEND_API_KEY     outbound email, ADR-011
	//   VAPID_PRIVATE_KEY  Web Push signing
	//   VAPID_PUBLIC_KEY   Web Push, also exposed to the client
	//   SESSION_SECRET     session cookie signing

	// Phase 2 adds the notification machinery (docs/roadmap.md). Both need the
	// paid plan for Queues, and a wrapper entry that re-exports the adapter's
	// fetch handler alongside scheduled() and queue():
	//
	// "triggers": { "crons": ["*/15 * * * *"] },
	// "queues": {
	//   "producers": [{ "binding": "NOTIFY", "queue": "almostdonedear-notify" }],
	//   "consumers": [{ "queue": "almostdonedear-notify", "max_batch_size": 10 }]
	// },
}
